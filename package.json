{
  "name": "dsh-tool-cards",
  "version": "0.2.1",
  "type": "module",
  "description": "Interactive cards for DeepSeek Harness replies, rendered from a tool result: sliders, selects, forms, charts and tables, with a submit action that flows back to the agent as a real user message.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "host.js",
    "protocol.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "build": "node build-client.mjs",
    "check": "node tools/selftest.mjs",
    "check:security": "node tools/security-test.mjs",
    "check:boundary": "node tools/boundary-test.mjs",
    "check:v020": "node tools/v020-test.mjs",
    "check:overflow": "node tools/overflow-test.mjs",
    "check:prompt": "node tools/diag-prompt.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "devDependencies": {
    "@json-render/core": "^0.21.1",
    "@json-render/react": "^0.21.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "jsdom": "^30.1.3"
  },
  "license": "MIT",
  "author": "clzx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wszw142857-beep/dsh-tool-cards.git"
  },
  "homepage": "https://github.com/wszw142857-beep/dsh-tool-cards#readme",
  "bugs": {
    "url": "https://github.com/wszw142857-beep/dsh-tool-cards/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "chat-ui",
    "interactive",
    "generative-ui",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  }
}
